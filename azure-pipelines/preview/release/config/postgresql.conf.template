# Preview PostgreSQL config — rendered to postgresql.conf at deploy time.
# Tune via preview/env.template (PG_MAX_CONNECTIONS, PG_SHARED_BUFFERS, etc.)

listen_addresses = '*'
port = 5432
max_connections = __PG_MAX_CONNECTIONS__

shared_preload_libraries = 'pg_stat_statements'

# Sized for preview stacks (not RC production values)
shared_buffers = __PG_SHARED_BUFFERS__
effective_cache_size = __PG_EFFECTIVE_CACHE_SIZE__

track_io_timing = on
track_wal_io_timing = on
random_page_cost = 1.0

max_wal_size = __PG_MAX_WAL_SIZE__
checkpoint_timeout = __PG_CHECKPOINT_TIMEOUT__
checkpoint_completion_target = 0.9

log_destination = stderr
logging_collector = off
log_min_duration_statement = __PG_LOG_MIN_DURATION_MS__
log_line_prefix = '%m [%p] %u@%d %r'
log_min_messages = info
