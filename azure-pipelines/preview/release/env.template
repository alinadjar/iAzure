# Rendered to .env at deploy time. 

ERP=fx
REGISTRY_URL=nexus.sadgan.int
LicenseServer=https://api-license-alpha.sadgan.com

WIT_ID=__WIT_ID__
ERP_VERSION=__ERP_VERSION__

SelfUrl=https://__API_HOST__
CorsOrigins=https://__FRONT_HOST__,https://__API_HOST__

DEPLOY_PATH=__DEPLOY_PATH__
COMPOSE_PROJECT_NAME=preview-__WIT_ID__

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_RO_PASSWORD=1234
POSTGRES_DB=SADGAN
PG_RW_HOST=pg-__WIT_ID__
PG_RW_USER=postgres
# Unique host port per task (computed at deploy: 10000 + WIT_ID). Backend uses pg:5432 on preview_net.
PG_HOST_PORT=5432
PG_MaxPoolSize=100
PG_RO_HOST=pg-__WIT_ID__
PG_RO_PORT=5432
PG_RO_USER=readonly_user
PG_MaxPoolSize_RO=100
REPLICA_IP_LB=pg-__WIT_ID__
REPLICA_PORT_LB=5432
PG_REPLICA_USER=replica_user
PG_REPLICA_PASSWORD=123456
PG_MaxPoolSize_REPLICA=100
PG_BI_USER=ro
POSTGRES_BI_PASSWORD=

REDIS_PASSWORD=1234
REDIS_HOST=redis-__WIT_ID__
MONGO_HOST=mongo-__WIT_ID__

# PostgreSQL tuning (rendered into config/postgresql.conf)
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAX_WAL_SIZE=2GB
PG_CHECKPOINT_TIMEOUT=15min
PG_LOG_MIN_DURATION_MS=300
