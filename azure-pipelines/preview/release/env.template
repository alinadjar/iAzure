# Rendered to .env at deploy time. Secrets should come from Azure DevOps variable groups.
ERP=fx
REGISTRY_URL=registry.sadgan.int
LicenseServer=https://api-license-alpha.sadgan.com

TASK_ID=__TASK_ID__
ERP_VERSION=__ERP_VERSION__

SelfUrl=https://__API_HOST__
CorsOrigins=https://__FRONT_HOST__,https://__API_HOST__

DEPLOY_PATH=__DEPLOY_PATH__
COMPOSE_PROJECT_NAME=preview-__TASK_ID__

POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_RO_PASSWORD=__POSTGRES_RO_PASSWORD__
POSTGRES_DB=SADGAN
PG_RW_HOST=pg
PG_RW_USER=postgres
# Unique host port per task (computed at deploy: 10000 + TASK_ID). Backend uses pg:5432 on preview_net.
PG_HOST_PORT=__PG_HOST_PORT__
PG_MaxPoolSize=100
PG_RO_HOST=pg
PG_RO_PORT=5432
PG_RO_USER=readonly_user
PG_MaxPoolSize_RO=100
REPLICA_IP_LB=pg
REPLICA_PORT_LB=5432
PG_REPLICA_USER=replica_user
PG_REPLICA_PASSWORD=__PG_REPLICA_PASSWORD__
PG_MaxPoolSize_REPLICA=100
PG_BI_USER=ro
POSTGRES_BI_PASSWORD=__POSTGRES_BI_PASSWORD__

REDIS_PASSWORD=__REDIS_PASSWORD__

# PostgreSQL tuning (rendered into config/postgresql.conf)
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAX_WAL_SIZE=2GB
PG_CHECKPOINT_TIMEOUT=15min
PG_LOG_MIN_DURATION_MS=300
